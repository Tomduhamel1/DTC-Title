    "test:pdf-runtime": "node --test test/pdf-runtime.browser.test.cjs",
    "test:http-runtime": "node --test test/runtime-http.pg.test.cjs",
    "preview:email": "node scripts/preview-emails.cjs",
    "start": "next start -p 5273",
    "lint": "next lint",
