# ─────────────────────────────────────────────────────────────────────────
# BetterClose — environment variable reference
# Copy to .env (local) or paste these into Render's Environment tab (prod).
# ─────────────────────────────────────────────────────────────────────────

# Server port. Render injects PORT automatically; for local dev we use 5273.
# (Avoid 5173 — that's Vite's default and is used by the garden-GOOD repo.)
PORT=5273

# ── Pre-launch gate ──────────────────────────────────────────────────────
# Set to "true" on the live deploy to redirect public marketing pages
# (homepage, /about, /for-brokers, etc.) to /coming-soon. Functional routes
# stay live: /dashboard, /login, /quote, /api/*, /for-my-lender.
# Leave unset (or "false") in local dev.
COMING_SOON_MODE="false"

# ── Admin allowlist ──────────────────────────────────────────────────────
# Comma-separated list of email addresses that can reach /admin and the
# /api/admin/* routes. Matched case-insensitively against the signed-in
# user's email. Promote to a User.role column when we need finer roles.
ADMIN_EMAILS="tomduhamel@gmail.com,tom@servist.co"

# ── Database ─────────────────────────────────────────────────────────────
# Local: bring up the Docker postgres with `npm run db:up`
DATABASE_URL="postgresql://betterclose:betterclose@localhost:5433/betterclose?schema=public"

# ── NextAuth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_ME_WITH_OPENSSL_RAND_HEX_32"
NEXTAUTH_URL="http://localhost:5273"

# Set to "true" to log magic-link URLs to console instead of sending email.
# In production, set to "false" (or omit).
AUTH_EMAIL_DRY_RUN="true"

# ── AWS SES (transactional email) ────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Domain must be verified in SES. Match this to a verified domain.
AWS_SES_FROM_EMAIL="noreply@betterclose.co"
# Reply-to address users see (separate inbox you can read).
HELLO_EMAIL="hello@betterclose.co"

# ── Order ingest webhook (title software → /api/orders/ingest) ──────────
# Generate with: openssl rand -hex 32
ORDER_INGEST_SECRET=""

# ── AWS S3 (document uploads, used by /start intake) ────────────────────
AWS_S3_BUCKET="betterclose-uploads"

# ── Quote engine (legacy /pricing flow) ─────────────────────────────────
QUOTE_PROVIDER_TYPE="config"
# Used only if QUOTE_PROVIDER_TYPE=external:
# RATECALC_API_URL=""
# RATECALC_API_KEY=""
# RATECALC_API_TIMEOUT="10000"

# ── Sentry (optional — leave blank to disable) ──────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENV="production"
NEXT_PUBLIC_SENTRY_ENV="production"
# Required only if you want source maps uploaded to Sentry on build:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
