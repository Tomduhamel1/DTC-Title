generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?

  // Address information
  address   String?
  city      String?
  state     String?
  zipCode   String?

  // Additional intake fields
  homeValue          Float?
  mortgageBalance    Float?
  currentRate        Float?
  creditScore        String?
  propertyType       String?

  // Metadata
  source    String?
  status    String   @default("new") // new, contacted, qualified, closed, lost
  notes     String?

  // Progressive intake
  intakeJson           Json?     // Partial intake form data
  completionPercentage Int?      @default(0) // 0-100
  resumeToken          String?   @unique // Magic link token
  tokenExpiresAt       DateTime? // Token expiration

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes            Quote[]
  activities        ActivityEvent[]
  documents         Document[]
  mortgageScenarios MortgageScenario[]
  mortgageReferrals MortgageReferral[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([resumeToken])
}

model Quote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Quote calculation inputs
  homeValue          Float
  mortgageBalance    Float
  currentRate        Float
  newRate            Float
  creditScore        String
  loanTerm           Int      @default(360) // months

  // Quote results
  currentMonthlyPayment Float
  newMonthlyPayment     Float
  monthlySavings        Float
  totalInterestCurrent  Float
  totalInterestNew      Float
  lifetimeSavings       Float
  closingCosts          Float?
  breakEvenMonths       Int?

  // Metadata
  isValid   Boolean  @default(true)
  expiresAt DateTime?
  pdfUrl    String?  // S3 URL for generated PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([createdAt])
}

model Document {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Document information
  type      String   // pay_stub, bank_statement, tax_return, id_document, etc.
  fileName  String
  fileSize  Int      // bytes
  mimeType  String
  s3Key     String   // S3 object key
  s3Url     String   // S3 URL

  // Metadata
  uploadedBy String?  // user or admin
  notes      String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

model MortgageScenario {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Source of data
  source    String   // user_entered, partner_quote, internal

  // Loan terms
  lenderName       String?
  loanAmount       Float
  interestRate     Float
  term             Int      // months
  points           Float?   // discount points
  lenderFees       Float?   // origination, processing, etc.

  // Optional PITI components
  propertyTaxes    Float?   // monthly
  homeInsurance    Float?   // monthly
  hoaFees          Float?   // monthly
  pmi              Float?   // monthly

  // Calculated values
  principalInterest Float   // monthly P&I
  totalMonthly      Float   // monthly PITI if provided, else P&I
  totalUpfront      Float   // lender fees + points + closing costs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([source])
  @@index([createdAt])
}

model MortgageReferral {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  // User preferences
  creditBand        String   // excellent, good, fair, poor
  occupancy         String   // primary, secondary, investment
  propertyType      String   // single_family, condo, etc.
  downPaymentPct    Float    // percentage
  termPreference    String   // 30_year, 15_year, arm
  contactPreference String   // email, phone, both

  // Additional context
  requestedLoanAmount Float?
  notes               String?

  // Referral status
  status            String   @default("pending") // pending, contacted, quoted, closed, declined
  partnerResponse   Json?    // Store partner's response
  partnerContactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?

  // Configuration
  isActive  Boolean  @default(true)
  priority  Int      @default(0) // Higher = preferred

  // Specialties
  specialties Json?   // { creditBands: [], propertyTypes: [], loanTypes: [] }

  // Metadata
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals MortgageReferral[]

  @@index([isActive])
  @@index([priority])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      String   // page_view, form_submit, email_sent, call_made, status_change, intake_started, intake_updated, doc_uploaded, mortgage_terms_added, mortgage_referral_requested
  action    String
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NextAuth (auth.js) required models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  closings Closing[] @relation("UserClosings")
  lenderRequests LenderRequest[]
  notifications NotificationLog[]

  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Closing dashboard
// ─────────────────────────────────────────────────────────────────────────────

model Closing {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("UserClosings", fields: [userId], references: [id], onDelete: SetNull)

  propertyAddress    String?
  propertyCity       String?
  propertyState      String?
  propertyZip        String?
  propertyAddressKey String?
  propertyType       String?
  salePrice          Float?
  loanAmount         Float?
  closingDate        DateTime?

  borrowerEmail String?
  borrowerPhone String?

  lenderName    String?
  lenderCompany String?
  lenderEmail   String?
  lenderPhone   String?
  lenderNmls    String?

  agentName    String?
  agentCompany String?
  agentEmail   String?
  agentPhone   String?

  titleUnderwriter String?
  titlePolicyNo    String?

  closingLocation String?

  status String @default("pending")
  source String?

  // Snapshot of the fee report at the moment this closing was marked `closed`.
  // Frozen so the final-summary email and any post-close dashboard view show
  // the actual savings the customer locked in, not whatever the live fee API
  // returns later.
  snapshotFeeReport Json?
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  lenderRequests LenderRequest[]
  notifications NotificationLog[]

  @@index([userId])
  @@index([propertyAddressKey])
  @@index([borrowerPhone])
  @@index([borrowerEmail])
  @@index([status])
}

model Milestone {
  id          String    @id @default(cuid())
  closingId   String
  closing     Closing   @relation(fields: [closingId], references: [id], onDelete: Cascade)

  kind        String    // loan_locked | title_ordered | title_search | title_issued | closed
  status      String    @default("pending") // pending | active | done
  completedAt DateTime?
  notifiedAt  DateTime? // when the user was emailed about this milestone reaching `done`
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([closingId, kind])
  @@index([closingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lender-request tracking (every share action — for funnel analytics + ops)
// ─────────────────────────────────────────────────────────────────────────────

model LenderRequest {
  id     String  @id @default(cuid())
  refId  String  @unique // short id used in share URLs

  // Optional links — populated when a logged-in user triggers the share from
  // the dashboard. Anonymous shares from marketing pages leave these null.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  closingId String?
  closing   Closing? @relation(fields: [closingId], references: [id], onDelete: SetNull)

  // Channel of the share
  channel String // 'sms' | 'mailto' | 'we_email' | 'copy_link' | 'native_share'

  // Only populated when channel = 'we_email'
  lenderEmail     String?
  lenderFirstName String?
  lenderCompany   String?
  clientName      String?
  clientEmail     String?
  note            String?

  savingsEstimate Float?

  source String // 'quote_results' | 'ready_to_save' | 'hero' | 'how_it_works' | 'fee_report_preview' | 'story_calculator' | 'dashboard_account'
  status String @default("sent") // sent | failed | opened | replied | converted

  createdAt DateTime @default(now())

  @@index([refId])
  @@index([createdAt])
  @@index([channel])
  @@index([userId])
  @@index([closingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NotificationLog — every transactional email (or other notification) we send,
// recorded so admins can audit "did the user get this, when, and from whom".
// One row per send attempt; failures stay in the table with status=failed.
// ─────────────────────────────────────────────────────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  closingId String?
  closing   Closing? @relation(fields: [closingId], references: [id], onDelete: SetNull)

  // Channel of delivery — currently only 'email', but leaves room for sms etc.
  channel   String   @default("email")

  // Logical kind of notification. Use prefixes to keep this groupable, e.g.
  // 'milestone:loan_locked', 'milestone:closed', 'magic_link',
  // 'lender_invite', 'admin_resend:closing_update'.
  kind      String

  // Where it was sent and what it said.
  recipient String
  subject   String

  // Provider message id (SES MessageId) when the send succeeded.
  providerMessageId String?

  // sent | failed | skipped (e.g. dry-run)
  status    String   @default("sent")
  error     String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([closingId])
  @@index([kind])
  @@index([createdAt])
}
